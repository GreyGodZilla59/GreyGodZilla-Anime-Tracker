{
  "appId": "com.greygodzilla.animetracker",
  "appName": "Grey GodZilla Anime Tracker",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0a0a0a",
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0a0a0a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0a"
    }
  }
}
