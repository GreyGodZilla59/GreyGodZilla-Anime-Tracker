<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/player_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#141414"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close player"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#f5f5f5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Grey GodZilla Anime App"
                android:textColor="#ff6a00"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Now playing"
                android:textColor="#f5f5f5"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_rotate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rotate"
            android:src="@android:drawable/ic_menu_always_landscape_portrait"
            android:tint="#f5f5f5" />

        <ImageButton
            android:id="@+id/btn_pip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Picture in picture"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#f5f5f5" />

        <ImageButton
            android:id="@+id/btn_fullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fullscreen"
            android:src="@android:drawable/ic_menu_crop"
            android:tint="#f5f5f5" />
    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <TextView
        android:id="@+id/player_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141414"
        android:padding="10dp"
        android:text="Loading stream…"
        android:textColor="#b0b0b0"
        android:textSize="12sp" />
</LinearLayout>
